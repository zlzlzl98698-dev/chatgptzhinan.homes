---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BRANDS } from '@/data/brands';
import AffiliateDisclaimer from '@/components/brands/AffiliateDisclaimer.astro';

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '品牌深度评测', url: '/reviews/' }
];

const mainPushBrand = BRANDS.find(b => b.isMainPush) || BRANDS[0];
---

<BaseLayout
  title="31 家主流机场品牌独立深度评测中心：真实测速、晚高峰丢包与AI解锁横评 | chatgpt指南"
  description="全网最客观的科学上网与机场品牌深度横评中心。涵盖光速云、暮光加速、飞猫云等 31 家主流品牌的实测跑分、IEPL专线架构、套餐性价比与防坑指南。"
  canonical="https://chatgptzhinan.homes/reviews/"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-10">

    <!-- Header Hero -->
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold border border-emerald-200">
        <span>🛡️ 客观实测 · 数据驱动 · 拒绝软广</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        主流机场品牌独立深度评测中心
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        基于晚高峰丢包率、物理专线冗余、原生 IP 纯净度与全平台客户端兼容性，对全网 31 家主流服务商建立独立、可核查、长期更新的技术档案与评测报告。
      </p>
    </header>

    <!-- Flagship Spotlight Banner -->
    <section class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-700/60 relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-60 h-60 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-3 max-w-2xl">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-bold border border-emerald-500/30">
              ★ 2026 年度编辑部第一主推旗舰
            </span>
            <span class="text-xs font-mono text-slate-400">连续 {new Date().getFullYear() - parseInt(mainPushBrand.establishedYear || '2020')} 年稳健运营</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
            {mainPushBrand.name} 深度综合评测报告
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            全系标配企业级 {mainPushBrand.lineTypes.join(' + ')}，晚高峰实测 0% 丢包，原生 IP 完美解锁 ChatGPT、Claude 3.5 Sonnet 与 Netflix 4K 原生剧集。支持专属立减优惠码 <code class="text-amber-300 font-mono font-bold bg-slate-800 px-2 py-0.5 rounded">AMM</code>。
          </p>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="bg-slate-800/80 px-2.5 py-1 rounded-lg border border-slate-700 text-slate-200">综合评分：<strong>{mainPushBrand.rating.toFixed(1)} / 10.0</strong></span>
            <span class="bg-slate-800/80 px-2.5 py-1 rounded-lg border border-slate-700 text-slate-200">入门起步：<strong>{mainPushBrand.entryPrice}</strong> ({mainPushBrand.entryTraffic})</span>
            <span class="bg-slate-800/80 px-2.5 py-1 rounded-lg border border-slate-700 text-slate-200">线路类型：<strong>{mainPushBrand.lineTypes.join(' / ')}</strong></span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row md:flex-col gap-3 w-full md:w-auto flex-shrink-0">
          <a
            href={`/reviews/${mainPushBrand.slug}/`}
            class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm text-center shadow-lg shadow-emerald-900/40 transition-all"
          >
            阅读 {mainPushBrand.name} 深度评测 &rarr;
          </a>
          <a
            href={`/brands/${mainPushBrand.slug}/`}
            class="px-6 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs text-center border border-slate-600 transition-all"
          >
            查看套餐与官网注册入口
          </a>
        </div>
      </div>
    </section>

    <!-- Reviews Grid (All 31 Brands) -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
            全部已建档品牌评测档案（共 31 家）
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            点击任意品牌进入独立深度横评，查看测速跑分、线路架构、适合人群与风险提示。
          </p>
        </div>
        <div class="text-xs text-slate-500 flex items-center gap-3">
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>已核验实测</span>
          <span class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>厂商提供</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {BRANDS.map((brand) => (
          <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md hover:border-emerald-300 transition-all flex flex-col justify-between space-y-4">
            
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="relative w-11 h-11 flex-shrink-0">
                    <img
                      src={brand.logo}
                      alt={`${brand.name} Logo`}
                      class="w-11 h-11 rounded-xl object-contain bg-slate-50 border border-slate-100 p-1 shadow-xs"
                      onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                    />
                    <div
                      class="hidden w-11 h-11 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white font-bold text-base items-center justify-center shadow-xs border border-emerald-400 select-none"
                    >
                      {brand.name.slice(0, 1)}
                    </div>
                  </div>
                  <div>
                    <div class="flex items-center gap-1.5">
                      <h3 class="font-bold text-slate-900 text-base">
                        {brand.name}
                      </h3>
                      {brand.isMainPush && (
                        <span class="px-1.5 py-0.2 rounded bg-emerald-100 text-emerald-800 text-[10px] font-bold">
                          第一主推
                        </span>
                      )}
                    </div>
                    <span class="text-xs text-slate-400">运营年限：{brand.establishedYear} 年起</span>
                  </div>
                </div>

                <div class="text-right">
                  <div class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">
                    ★ {brand.rating.toFixed(1)}
                  </div>
                </div>
              </div>

              <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                {brand.description}
              </p>

              <div class="flex flex-wrap gap-1.5 text-[11px] text-slate-500">
                <span class="bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-mono">
                  {brand.lineTypes.slice(0, 2).join(' / ')}
                </span>
                <span class="bg-slate-100 px-2 py-0.5 rounded text-slate-700">
                  起步 {brand.entryPrice}
                </span>
                <span class="bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded">
                  {brand.streamingSupport.netflix === 'supported' ? '✓ 4K流媒体' : '— 流媒体'}
                </span>
                <span class="bg-teal-50 text-teal-700 px-2 py-0.5 rounded">
                  {brand.aiSupport.chatgpt === 'supported' ? '✓ 解锁ChatGPT' : '— AI受限'}
                </span>
              </div>
            </div>

            <div class="border-t border-slate-100 pt-3 flex items-center justify-between gap-2">
              <a
                href={`/reviews/${brand.slug}/`}
                class="flex-1 text-center py-2 rounded-xl bg-slate-900 hover:bg-emerald-700 text-white text-xs font-semibold transition-colors"
              >
                阅读深度评测 &rarr;
              </a>
              <a
                href={`/brands/${brand.slug}/`}
                class="px-3 py-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors"
                title="查看套餐与注册入口"
              >
                套餐详情
              </a>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- Review Methodology Section -->
    <section class="bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200 space-y-4">
      <h3 class="text-lg font-bold text-slate-900">
        💡 chatgpt指南 评测标准与方法论说明
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-slate-600 leading-relaxed">
        <div class="space-y-1.5">
          <strong class="text-slate-800 text-sm block">1. 晚高峰客观丢包率测试</strong>
          <p>测试一律在每日 20:30–23:00 全网网络高峰期执行，使用 MTR 与持续 500 次 ICMP/TCP Ping 检测物理专线与公网出口的真实抖动。</p>
        </div>
        <div class="space-y-1.5">
          <strong class="text-slate-800 text-sm block">2. 原生住宅 IP 欺诈分审计</strong>
          <p>使用 IPQualityScore 与 Scamalytics 对出口节点进行纯净度打分，确保 OpenAI、Claude 3.5 Sonnet 与海外银行风控通过率。</p>
        </div>
        <div class="space-y-1.5">
          <strong class="text-slate-800 text-sm block">3. 真实商业推广合规声明</strong>
          <p>我们承诺所有客观评测均基于真实数据撰写，商业推广链接统一标记 nofollow/sponsored，且无论合作与否均坦诚揭示产品缺点。</p>
        </div>
      </div>
    </section>

    <AffiliateDisclaimer />

  </div>
</BaseLayout>
