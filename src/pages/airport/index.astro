              <p class="text-xs text-slate-600 leading-relaxed mb-3 line-clamp-2">
                {sub.heroAnswer}
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400">含独立实测与FAQ</span>
              <a href={`/airport/${sub.slug}/`} class="text-emerald-600 font-semibold hover:underline">
                进入专题 &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 7: FAQ -->
    <section id="faq" class="space-y-4 pt-6 border-t border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
        <span>❓</span>
