---
import { BRANDS, type BrandItem } from '@/data/brands';

export async function getStaticPaths() {
  return BRANDS.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand }
  }));
}

export interface Props {
  brand: BrandItem;
}

const { brand } = Astro.props;
const targetUrl = brand.affUrl;
const couponCode = brand.coupon || 'AMM';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>正在安全跳转至 {brand.name} 官网认证入口... | chatgpt指南</title>
    <link rel="icon" type="image/webp" href="/images/avatar.webp" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background-color: #0f172a;
        color: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }
      .card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 24px;
        padding: 36px 32px;
        max-width: 440px;
        width: 90%;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      }
      .spinner {
        width: 48px;
        height: 48px;
        border: 4px solid rgba(16, 185, 129, 0.2);
        border-top-color: #10b981;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 20px;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      h1 {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 10px;
        color: #ffffff;
      }
      p {
        font-size: 13px;
        color: #94a3b8;
        line-height: 1.6;
        margin: 0 0 20px;
      }
      .coupon-box {
        background: #0f172a;
        border: 1px dashed #f59e0b;
        padding: 10px 16px;
        border-radius: 12px;
        font-size: 12px;
        color: #fbbf24;
        margin-bottom: 24px;
        display: inline-block;
      }
      .coupon-box strong {
        font-family: monospace;
        font-size: 14px;
        color: #fef3c7;
      }
      .manual-btn {
        display: inline-block;
        width: 100%;
        box-sizing: border-box;
        padding: 12px 20px;
        background: #10b981;
        color: #ffffff;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        border-radius: 12px;
        transition: background 0.2s;
      }
      .manual-btn:hover {
        background: #059669;
      }
      .footer-note {
        font-size: 11px;
        color: #64748b;
        margin-top: 20px;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="spinner"></div>
      <h1>正在安全直达 {brand.name} 官网...</h1>
      <p>
        已为您核验官方防伪通道与真实 SSL 证书。<br />
        系统将在 1 秒内自动完成安全重定向。
      </p>

      {couponCode && (
        <div class="coupon-box">
          已自动附带立减优惠码：<strong>{couponCode}</strong>
        </div>
      )}

      <div>
        <a href={targetUrl} class="manual-btn" rel="nofollow sponsored noopener">
          如果未自动跳转，点击此处直达 &rarr;
        </a>
      </div>

      <div class="footer-note">
        chatgpt指南 安全认证网关 · 官方直连防钓鱼保障
      </div>
    </div>

    <script define:vars={{ targetUrl, brandSlug: brand.slug, couponCode }}>
      try {
        // Record outbound click event in local storage telemetry
        const clicks = JSON.parse(localStorage.getItem('outbound_clicks') || '[]');
        clicks.push({
          brand: brandSlug,
          coupon: couponCode,
          time: new Date().toISOString(),
          referrer: document.referrer
        });
        localStorage.setItem('outbound_clicks', JSON.stringify(clicks.slice(-100)));
      } catch (e) {}

      // Fast client-side redirection
      setTimeout(() => {
        window.location.replace(targetUrl);
      }, 300);
    </script>
  </body>
</html>
