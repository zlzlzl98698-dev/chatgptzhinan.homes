---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { TOPICS, type TopicItem } from '@/data/topics';
import { BRANDS } from '@/data/brands';
import BrandCard from '@/components/brands/BrandCard.astro';
import AffiliateDisclaimer from '@/components/brands/AffiliateDisclaimer.astro';

export async function getStaticPaths() {
  // Exclude 'brands' because it has its own dedicated rich interactive search page
  const list = TOPICS.filter(t => t.slug !== 'brands');
  return list.map(topic => ({
    params: { topic: topic.slug },
    props: { topic }
  }));
}

export interface Props {
  topic: TopicItem;
}

const { topic } = Astro.props;

// Pick recommended brands for this topic
const relevantBrands = BRANDS.slice(0, 3);

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: topic.navTitle, url: `/${topic.slug}/` }
];

const topicSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': topic.title,
  'description': topic.description,
  'url': `https://chatgptzhinan.homes/${topic.slug}/`,
  'about': {
    '@type': 'Thing',
    'name': topic.navTitle,
    'description': topic.description
  }
};
---

<BaseLayout
  title={`${topic.title} | chatgpt指南`}
  description={topic.description}
  canonical={`https://chatgptzhinan.homes/${topic.slug}/`}
  breadcrumbs={breadcrumbs}
  schema={topicSchema}
>

  <!-- Answer-First Hero Header -->
  <div class="py-8 max-w-4xl mx-auto space-y-4">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold">
      <span>📌 {topic.badge}</span>
      <span>·</span>
      <span>一级权威专题中心</span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
      {topic.title}
    </h1>

    <!-- Answer-First Direct Takeaway Card -->
    <div class="rounded-2xl bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-200/80 p-5 sm:p-6 shadow-sm my-6">
      <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm mb-2">
        <span>💡 核心结论先行（Answer-First Summary）</span>
      </div>
      <p class="text-sm sm:text-base text-slate-800 leading-relaxed font-medium">
        {topic.heroAnswer}
      </p>
      <div class="mt-3 pt-3 border-t border-emerald-200/60 flex items-center justify-between text-xs text-emerald-700">
        <span>涵盖 {topic.subtopics.length} 个细分高频搜索意图与长尾实测</span>
        <span>最近更新：2026-11-21</span>
      </div>
    </div>
  </div>

  <!-- Subtopic Hubs Grid (8 Subtopics) -->
  <section class="py-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
        📑 二级细分专题与长尾主题中心
      </h2>
      <span class="text-xs text-slate-400">共 {topic.subtopics.length} 个深度中心</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {topic.subtopics.map((sub, idx) => (
        <div class="rounded-2xl bg-white border border-slate-200 hover:border-emerald-500 hover:shadow-lg transition-all p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-emerald-600">
                TOPIC #{idx + 1}
              </span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-medium uppercase">
                {sub.searchIntent === 'commercial' ? '选购调查' : (sub.searchIntent === 'transactional' ? '优惠折扣' : '深度教程')}
              </span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 mb-2">
              <a href={`/${topic.slug}/${sub.slug}/`} class="hover:text-emerald-600 transition-colors">
                {sub.title}
              </a>
            </h3>

            <!-- Subtopic Answer First -->
            <p class="text-xs text-slate-600 leading-relaxed mb-4 bg-slate-50 p-3 rounded-xl border border-slate-100">
              <strong class="text-slate-800">直接答案：</strong>{sub.heroAnswer}
            </p>

            <!-- Key Decision Factors -->
            <div class="my-3">
              <div class="text-[11px] font-semibold text-slate-400 uppercase mb-1.5">核心评估维度：</div>
              <div class="flex flex-wrap gap-1.5">
                {sub.keyFactors.map((kf) => (
                  <span class="text-[11px] px-2 py-0.5 rounded bg-slate-100 text-slate-600">
                    {kf}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-400">含 {sub.faqs.length} 个常见问答排查</span>
            <a
              href={`/${topic.slug}/${sub.slug}/`}
              class="font-semibold text-emerald-600 hover:text-emerald-700 flex items-center gap-1 group"
            >
              <span>阅读专题完整指南</span>
              <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Relevant Featured Brands for this Topic -->
  <section class="py-10 border-t border-slate-200 my-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
          ⚡ 适用于本专题的实测推荐服务商
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          根据本专题的技术指标与场景需求筛选，提供真实的测试记录与安全官网入口。
        </p>
      </div>
      <a href="/brands/" class="text-xs font-semibold text-emerald-600 hover:underline">
        查看完整 31 家品牌库 &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {relevantBrands.map((b) => (
        <BrandCard brand={b} />
      ))}
    </div>
  </section>

  <div class="my-8">
    <AffiliateDisclaimer />
  </div>

</BaseLayout>
