---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  publishDate?: string;
  modifiedDate?: string;
  robots?: string;
  schema?: Record<string, any> | Record<string, any>[];
  googleVerification?: string;
  bingVerification?: string;
  shenmaVerification?: string;
  baiduVerification?: string;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  publishDate = '2026-10-19',
  modifiedDate = '2026-11-22',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  schema,
  googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION,
  bingVerification = import.meta.env.BING_SITE_VERIFICATION,
  shenmaVerification = import.meta.env.SHENMA_SITE_VERIFICATION,
  baiduVerification = import.meta.env.BAIDU_SITE_VERIFICATION
} = Astro.props;

const siteUrl = 'https://chatgptzhinan.homes';
const cleanPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const defaultCanonical = `${siteUrl}${cleanPath}`;
const effectiveCanonical = canonical && canonical.startsWith('https://chatgptzhinan.homes') 
  ? canonical 
  : defaultCanonical;

const fullTitle = title.includes('chatgpt指南') ? title : `${title} | chatgpt指南`;

// Base WebSite & Organization Schema
const baseSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    'name': 'chatgpt指南',
    'url': siteUrl,
    'potentialAction': {
      '@type': 'SearchAction',
      'target': `${siteUrl}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    'name': 'chatgpt指南',
    'url': siteUrl,
    'logo': `${siteUrl}/images/avatar.webp`
  }
];

const allSchemas = schema 
  ? (Array.isArray(schema) ? [...baseSchemas, ...schema] : [...baseSchemas, schema])
  : baseSchemas;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={effectiveCanonical} />

<!-- Favicon / Brand Avatar -->
<link rel="icon" type="image/webp" href="/images/avatar.webp" />
<link rel="shortcut icon" href="/images/avatar.webp" />
<link rel="apple-touch-icon" href="/images/avatar.webp" />

<!-- Search Engine Webmaster Verification Meta Slots (预留各大站长平台验证入口) -->
{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
{shenmaVerification && <meta name="shenma-site-verification" content={shenmaVerification} />}
{baiduVerification && <meta name="baidu-site-verification" content={baiduVerification} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={effectiveCanonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="chatgpt指南" />
<meta property="og:image" content={`${siteUrl}/images/avatar.webp`} />
{ogType === 'article' && (
  <>
    <meta property="article:published_time" content={`${publishDate}T08:00:00+08:00`} />
    <meta property="article:modified_time" content={`${modifiedDate}T12:00:00+08:00`} />
    <meta property="article:author" content="chatgpt指南独立实验室" />
    <meta property="article:section" content="科学上网与AI工具评测" />
  </>
)}

<!-- Twitter Card -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={effectiveCanonical} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={`${siteUrl}/images/avatar.webp`} />

<!-- Robots Indexing Control -->
<meta name="robots" content={robots} />

<!-- Structured Data (JSON-LD) -->
{allSchemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}

<!-- Pagefind Assets Link -->
<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
