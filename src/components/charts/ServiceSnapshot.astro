---
import type { BrandItem } from '@/data/brands';

export interface Props {
  brand: BrandItem;
}

const { brand } = Astro.props;
---

<div class="my-6 rounded-2xl bg-slate-950 border border-slate-800 text-slate-100 p-5 sm:p-6 shadow-2xl font-mono text-xs overflow-hidden">
  
  <div class="flex items-center justify-between pb-4 border-b border-slate-800">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
      <span class="font-bold text-sm tracking-wide text-white">
        📊 {brand.name} · 基础设施服务快照
      </span>
      <span class="px-2 py-0.5 rounded text-[10px] bg-slate-800 text-slate-300 border border-slate-700">
        Infrastructure Snapshot
      </span>
    </div>
    <div class="text-slate-400 text-[11px]">
      数据状态: <span class="text-emerald-400 font-bold">{brand.dataStatus === 'verified' ? '已核实有效' : (brand.dataStatus === 'vendor' ? '厂商资料' : '待人工复核')}</span>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 my-5">
    
    <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800">
      <div class="text-[10px] text-slate-400 uppercase">开业运营年限</div>
      <div class="text-slate-200 font-bold text-sm mt-1">{brand.establishedYear}</div>
      <div class="text-[10px] text-slate-500 mt-0.5">运营信誉良好</div>
    </div>

    <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800">
      <div class="text-[10px] text-slate-400 uppercase">专线与线路</div>
      <div class="text-emerald-400 font-bold text-sm mt-1">{brand.lineTypes.join(' + ')}</div>
      <div class="text-[10px] text-slate-500 mt-0.5">企业级专线</div>
    </div>

    <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800">
      <div class="text-[10px] text-slate-400 uppercase">主要支持协议</div>
      <div class="text-cyan-400 font-bold text-sm mt-1">{brand.protocols.join(', ')}</div>
      <div class="text-[10px] text-slate-500 mt-0.5">现代抗审查加密</div>
    </div>

    <div class="bg-slate-900/80 p-3 rounded-xl border border-slate-800">
      <div class="text-[10px] text-slate-400 uppercase">入门起售价</div>
      <div class="text-amber-400 font-bold text-sm mt-1">{brand.entryPrice}</div>
      <div class="text-[10px] text-slate-500 mt-0.5">含 {brand.entryTraffic} 流量</div>
    </div>

  </div>

  <div class="flex flex-wrap items-center justify-between text-[11px] text-slate-400 pt-3 border-t border-slate-800 gap-2">
    <div>
      覆盖节点: <span class="text-slate-200">{brand.nodeRegions.join(' · ')}</span>
    </div>
    <div>
      更新时间: <span class="text-slate-300 font-mono">{brand.updateTime}</span>
    </div>
  </div>

</div>
