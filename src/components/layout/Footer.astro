---
import { TOPICS } from '@/data/topics';
import { BRANDS } from '@/data/brands';
---

<footer class="bg-slate-900 text-slate-400 text-xs border-t border-slate-800 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Top Grid: 10 Topics Sitemap -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-10 pb-10 border-b border-slate-800">
      {TOPICS.map((topic) => (
        <div>
          <a href={`/${topic.slug}/`} class="text-white font-semibold text-sm hover:text-emerald-400 transition-colors block mb-3">
            {topic.navTitle}
          </a>
          <ul class="space-y-1.5">
            {topic.subtopics.slice(0, 4).map((sub) => (
              <li>
                <a href={`/${topic.slug}/${sub.slug}/`} class="hover:text-slate-200 transition-colors">
                  {sub.title.split('：')[0]}
                </a>
              </li>
            ))}
            <li>
              <a href={`/${topic.slug}/`} class="text-emerald-500 hover:underline">
                更多专题 &rarr;
              </a>
            </li>
          </ul>
        </div>
      ))}
    </div>

    <!-- Middle: Brand Fast Navigation & Compliance Statement -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10 pb-8 border-b border-slate-800">
      
      <!-- Brand statement -->
      <div class="lg:col-span-1 space-y-3">
        <div class="flex items-center gap-2.5 text-white font-bold text-base">
          <img src="/images/avatar.webp" alt="chatgpt指南" class="w-7 h-7 rounded-lg object-cover border border-slate-700 flex-shrink-0" />
          <span>chatgpt指南</span>
          <span class="text-xs bg-emerald-900 text-emerald-300 font-normal px-2 py-0.5 rounded">权威知识矩阵</span>
        </div>
        <p class="text-slate-400 leading-relaxed">
          面向需要使用 ChatGPT、Claude、Gemini、海外互联网工具与客户端的中文用户，提供真实客观的测速报告、软件教程与品牌横评。
        </p>
        <div class="text-slate-500 text-[11px]">
          最后全面审计更新：2026 年 11 月 21 日
        </div>
      </div>

      <!-- Compliance Affiliate Statement -->
      <div class="lg:col-span-2 bg-slate-800/60 rounded-xl p-4 border border-slate-700/60">
        <div class="text-slate-300 font-semibold mb-1 flex items-center gap-1.5">
          <span>⚖️ 商业合作与合规免责声明</span>
        </div>
        <p class="text-slate-400 leading-relaxed text-[11px]">
          本文可能包含推广链接，通过链接注册可能为本站带来佣金。请以品牌官方当前套餐和服务条款为准。
          本站所有评测数据均来源于真实测试环境与品牌官方已核实档案，商业推荐顺序严格与客观测试排名分离。
          机场属于第三方网络服务，服务可用性受国际网络环境影响，请理性按需选购，建议新手优先选择月付体验。
        </p>
      </div>

    </div>

    <!-- Bottom: Copyright & Links -->
    <div class="flex flex-col sm:flex-row items-center justify-between text-slate-500 text-[11px] gap-4">
      <div>
        &copy; 2026 chatgpt指南 (chatgptzhinan.homes). All rights reserved.
      </div>
      <div class="flex items-center gap-4 flex-wrap">
        <a href="/about/" class="hover:text-slate-300 text-emerald-400 font-semibold">关于我们与评测准则</a>
        <a href="/safety/privacy-protection/" class="hover:text-slate-300">隐私保护</a>
        <a href="/safety/refund-policy/" class="hover:text-slate-300">退款说明</a>
        <a href="/safety/security/" class="hover:text-slate-300">安全合规</a>
        <a href="/brands/" class="hover:text-slate-300">品牌数据库 ({BRANDS.length}家)</a>
        <a href="/reviews/" class="hover:text-slate-300 text-emerald-400 font-semibold">品牌深度评测</a>
        <a href="/sitemap-index.xml" class="hover:text-slate-300">网站地图</a>
      </div>
    </div>

  </div>
</footer>
