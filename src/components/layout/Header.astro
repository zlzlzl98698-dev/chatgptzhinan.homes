---
import { TOPICS } from '@/data/topics';
import { MAIN_PUSH_BRAND } from '@/data/brands';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200">
  <div class="max-w-[1440px] mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-2">
      
      <!-- Logo & Brand Name (Never shrink) -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center gap-2.5 group">
          <img
            src="/images/avatar.webp"
            alt="chatgpt指南 Logo"
            class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl object-cover shadow-sm group-hover:scale-105 transition-transform flex-shrink-0 border border-slate-200"
          />
          <div class="flex flex-col whitespace-nowrap">
            <span class="text-base sm:text-lg font-bold text-slate-900 tracking-tight leading-none group-hover:text-emerald-600 transition-colors">
              chatgpt指南
            </span>
            <span class="text-[11px] text-slate-400 font-mono hidden sm:inline">
              chatgptzhinan.homes
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation (10 Primary Topics + Brand Library) -->
      <nav class="hidden xl:flex items-center space-x-0.5 2xl:space-x-1 flex-1 justify-center px-1">
        {TOPICS.map((topic) => (
          <div class="relative group">
            <a
              href={`/${topic.slug}/`}
              class="px-1.5 2xl:px-2.5 py-1.5 text-xs 2xl:text-[13px] font-medium text-slate-700 hover:text-emerald-600 hover:bg-slate-50 rounded-lg transition-colors flex items-center gap-0.5 whitespace-nowrap"
            >
              <span>{topic.navTitle}</span>
              <svg class="w-3 h-3 text-slate-400 group-hover:text-emerald-600 group-hover:rotate-180 transition-transform flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            
            <!-- Dropdown Menu -->
            <div class="absolute left-1/2 -translate-x-1/2 mt-1 w-64 rounded-2xl bg-white shadow-xl border border-slate-100 p-2 hidden group-hover:block transition-all opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto z-50">
              <div class="text-[10px] font-bold text-slate-400 px-3 py-1 uppercase tracking-wider">
                {topic.navTitle} · 细分中心
              </div>
              <div class="space-y-0.5 my-1">
                {topic.subtopics.map((sub) => (
                  <a
                    href={`/${topic.slug}/${sub.slug}/`}
                    class="block px-3 py-1.5 text-xs text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 rounded-lg transition-colors truncate"
                  >
                    {sub.title.split('：')[0]}
                  </a>
                ))}
              </div>
              <div class="border-t border-slate-100 mt-1 pt-1">
                <a href={`/${topic.slug}/`} class="block px-3 py-1.5 text-xs text-emerald-600 font-semibold hover:underline">
                  进入【{topic.navTitle}】主专题 &rarr;
                </a>
              </div>
            </div>
          </div>
        ))}
        
        <!-- Brand Library Pill -->
        <a
          href="/brands/"
          class="ml-1 px-2.5 py-1.5 text-xs 2xl:text-[13px] font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg transition-colors whitespace-nowrap flex-shrink-0"
        >
          品牌库
        </a>
      </nav>

      <!-- Right Action Area (Never shrink, never truncate) -->
      <div class="flex-shrink-0 flex items-center gap-1.5 sm:gap-2.5">
        <!-- Search Trigger Button -->
        <a
          href="/search/"
          class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition-colors flex-shrink-0"
          title="站内全量搜索"
          aria-label="搜索"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>

        <!-- Main Push Direct Link -->
        <a
          href={`/go/${MAIN_PUSH_BRAND.slug}/`}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="flex-shrink-0 whitespace-nowrap inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-white bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 rounded-xl shadow-sm hover:shadow transition-all"
        >
          <span>🔥 光速云入口</span>
          <span class="bg-white/20 px-1 py-0.5 rounded text-[10px] font-mono hidden sm:inline">券: {MAIN_PUSH_BRAND.coupon}</span>
        </a>

        <!-- Mobile Menu Toggle Button (Visible on < xl) -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="xl:hidden p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl focus:outline-none flex-shrink-0"
          aria-label="切换菜单"
        >
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div id="mobile-menu" class="hidden xl:hidden border-t border-slate-200 bg-white max-h-[80vh] overflow-y-auto px-4 py-4 space-y-3 shadow-lg">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <a href="/brands/" class="font-bold text-emerald-700 text-sm flex items-center gap-1">
        <span>📚 31家机场品牌数据库</span>
        <span>&rarr;</span>
      </a>
      <a
        href={`/go/${MAIN_PUSH_BRAND.slug}/`}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="text-xs text-white bg-emerald-600 hover:bg-emerald-700 px-3 py-1 rounded-lg font-bold"
      >
        光速云入口 (券: {MAIN_PUSH_BRAND.coupon})
      </a>
    </div>

    {TOPICS.map((topic) => (
      <details class="group/m border-b border-slate-100 pb-2">
        <summary class="flex items-center justify-between py-1 text-sm font-medium text-slate-800 cursor-pointer list-none select-none">
          <div class="flex items-center gap-2">
            <span class="font-bold">{topic.navTitle}</span>
            <span class="text-[10px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded">{topic.subtopics.length}个主题</span>
          </div>
          <span class="text-xs text-slate-400 group-open/m:rotate-180 transition-transform">▼</span>
        </summary>
        <div class="pl-3 mt-1.5 space-y-1.5">
          <a href={`/${topic.slug}/`} class="block text-xs font-semibold text-emerald-600 py-1 hover:underline">
            &rarr; 查看【{topic.navTitle}】主专题首页
          </a>
          {topic.subtopics.map((sub) => (
            <a
              href={`/${topic.slug}/${sub.slug}/`}
              class="block text-xs text-slate-600 hover:text-emerald-700 py-0.5"
            >
              • {sub.title.split('：')[0]}
            </a>
          ))}
        </div>
      </details>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
